# Copy to .env for local development:  cp .env.example .env
# Then replace BOTH secrets. Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Real secrets never go in Git; in Kubernetes they come from a Secret.

# Signs and verifies login tokens. At least 32 characters.
AUTH_SECRET_KEY=replace-with-a-random-value-of-at-least-32-chars

# Password for the demo user "demo". At least 12 characters.
DEMO_PASSWORD=replace-with-a-long-password

# Port on YOUR computer for the API gateway (http://localhost:18090).
GATEWAY_PORT=18090
